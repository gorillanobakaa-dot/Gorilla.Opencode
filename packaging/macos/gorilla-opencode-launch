#!/bin/bash
# The executable inside "Gorilla OpenCode.app". A Mac app opens no Terminal
# window of its own, and Gorilla OpenCode lives in Terminal, so the app asks
# Terminal to run the launcher that sits beside it in the app's Resources.
# (Old windows coming back beside it: the installer turns Terminal's window
# restore off; open -F did not stop them on 10.13, 2026-10-23.)
exec open -a Terminal "$(cd "$(dirname "$0")/../Resources" && pwd)/Gorilla OpenCode.command"
