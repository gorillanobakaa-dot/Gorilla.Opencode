# Maintainer: gorillanobakaa <gorillanobakaa@gmail.com>
# GORILLA OVERRIDE: this PKGBUILD builds gorilla-opencode from source using the
# Go toolchain. It produces the same binary the Debian package ships: stripped
# (-s -w), version-stamped, no CGO.
#
# Two ways to install on Arch / CachyOS:
#   1. FROM SOURCE (this file):
#        git clone https://github.com/gorillanobakaa-dot/Gorilla.Opencode
#        cd Gorilla.Opencode/packaging
#        makepkg -si
#
#   2. PRE-BUILT binary package (no Go toolchain required):
#        Download gorilla-opencode-${pkgver}-1-x86_64.pkg.tar.zst from the
#        GitHub release page, then:
#        sudo pacman -U gorilla-opencode-${pkgver}-1-x86_64.pkg.tar.zst

pkgname=gorilla-opencode
# GORILLA OVERRIDE (2026-08-20): this sat at 0.1.85 while releases reached
# 0.1.111 - twenty-six behind. It is the file the README points Arch users at as
# install route 1, so following the project's own instructions built a version
# from July. Nothing checked it, because a stale version number is still a valid
# PKGBUILD: makepkg succeeds, the package installs, and only the version string
# betrays it. BUMP THIS WITH EVERY RELEASE; TestPKGBUILDTracksTheCurrentRelease
# now fails the build if it drifts.
pkgver=0.1.117
pkgrel=1
pkgdesc="Terminal AI coding agent (revived original OpenCode), bring your own API keys"
arch=('x86_64')
url="https://github.com/gorillanobakaa-dot/Gorilla.Opencode"
license=('MIT')
# GORILLA OVERRIDE (2026-08-20): three dependencies, not one. This declared lynx
# alone while the .deb declared lynx, python3 and ripgrep, so makepkg produced a
# package that installed cleanly and then had no working search.
#
#   python   - HARD. internal/llm/tools/find.go REFUSES without it: "the find
#              tool needs python3 (its search engine is a Python program
#              embedded in this binary)". find replaced ls, grep and glob, so
#              without python the agent has no search at all.
#              NOTE THE NAME: Arch ships this as `python`, NOT `python3`.
#              Copying the Debian string across verbatim yields an unsatisfiable
#              dependency - a silent gap turned into a package that will not
#              install.
#   ripgrep  - pfind.py accelerates through it when present (HAVE_RG) and works
#              without it. Declared anyway to match the .deb: per the 2026-08-09
#              lynx decision, a promise that only holds for people who install
#              the expert way is not a promise.
depends=('lynx' 'python' 'ripgrep')
makedepends=('go>=1.21')
# GORILLA: source is the tagged tarball from GitHub. The sha256sum covers the
# archive as downloaded; regenerate with `makepkg -g` after a version bump.
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/gorillanobakaa-dot/Gorilla.Opencode/archive/refs/tags/v${pkgver}.tar.gz")
# GORILLA OVERRIDE (2026-08-20): a real checksum, not SKIP.
#
# SKIP disables integrity checking entirely - makepkg accepts whatever arrives
# from the network. The comment above it had said "regenerate with makepkg -g"
# since the file was written, and nobody ever did. On a project whose SECURITY.md
# invites people to verify what they downloaded, shipping a recipe that verifies
# nothing is the "transparent in theory, closed door in practice" failure
# PHILOSOPHY.md exists to prevent.
#
# ORDERING, and why this hash always lands in the commit AFTER the tag
# (recorded 2026-08-23): this sum covers the tarball of the tag, and the tarball
# of the tag CONTAINS THIS FILE. Writing the correct hash into the file changes
# the file, which changes the tarball, which changes the hash. It is a fixed
# point and there is no value that satisfies it.
#
# That is not a theoretical problem: v0.1.114 shipped carrying the v0.1.111 sum,
# so `makepkg -si` on it downloaded the right tarball, compared it against the
# wrong hash and refused. The failure was loud, which is correct, but it landed
# on the user rather than on the person who forgot.
#
# It is survivable because of WHICH copy Arch users actually run. README install
# route 1 is `git clone` then `cd packaging` then `makepkg -si`, and a clone
# checks out the DEFAULT BRANCH, not a tag. So the working recipe is main's, and
# updating this line on main directly after pushing the tag is both correct and
# the only thing that can work.
#
# Procedure, every release: tag, push the tag, download
# archive/refs/tags/v${pkgver}.tar.gz, sha256sum it, paste it here, commit to
# main, then re-download and verify. Do not guess it and do not carry the
# previous release's value forward.
sha256sums=('c244490b89352c4a1252b6bd19d912c3e9fdb3c71902fad85d5ed0d7a165f30f')

build() {
    cd "Gorilla.Opencode-${pkgver}"
    # GORILLA OVERRIDE: -s -w strips symbol table and DWARF debug info.
    # On this project that shrinks the binary from ~66 MB to ~50 MB, roughly
    # 40 minutes on a single-digit-KB/s link at 50 MB vs 90 minutes at 66 MB.
    # Never drop this from a release build.
    CGO_ENABLED=0 go build \
        -ldflags "-s -w -X github.com/opencode-ai/opencode/internal/version.Version=v${pkgver}" \
        -o "${pkgname}" \
        .
}

package() {
    cd "Gorilla.Opencode-${pkgver}"

    # Binary
    install -Dm755 "${pkgname}" "${pkgdir}/usr/bin/${pkgname}"

    # Icons: hicolor sizes shipped in the repo
    for size in 128 256 512 1024; do
        install -Dm644 \
            "internal/assets/icons/${pkgname}-${size}.png" \
            "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/${pkgname}.png"
    done
    install -Dm644 \
        "internal/assets/icons/${pkgname}.svg" \
        "${pkgdir}/usr/share/icons/hicolor/scalable/apps/${pkgname}.svg"

    # Desktop entry: plain and plain-mode right-click action
    install -Dm644 \
        "packaging/gorilla-opencode.desktop" \
        "${pkgdir}/usr/share/applications/${pkgname}.desktop"

    # SearXNG setup helper (makes web search work out of the box)
    install -Dm755 \
        "packaging/setup-searxng.sh" \
        "${pkgdir}/usr/share/${pkgname}/setup-searxng.sh"

    # GORILLA OVERRIDE (2026-08-20): pfind. Absent from this file entirely until
    # today, and from scripts/build-arch.sh too - build-deb.sh gained it on
    # 2026-08-17 when the engine was vendored, and neither Arch recipe was
    # updated. Three packaging descriptions, all drifted apart; the same
    # per-format-copy failure that shipped a launcher with no plain-mode action
    # in v0.1.43.
    #
    # The same bytes are embedded in the binary (find.go go:embed), so this copy
    # is not what makes the tool work. It exists so users get a `pfind` CLI of
    # their own and so the search engine is inspectable as a plain file.
    install -Dm644 \
        "internal/llm/tools/pfind.py" \
        "${pkgdir}/usr/share/${pkgname}/pfind.py"
    install -d "${pkgdir}/usr/bin"
    cat > "${pkgdir}/usr/bin/pfind" <<'WRAP'
#!/bin/sh
exec python3 /usr/share/gorilla-opencode/pfind.py "$@"
WRAP
    chmod 755 "${pkgdir}/usr/bin/pfind"

    # Documentation
    install -Dm644 README.md       "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    install -Dm644 LICENSE         "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 PHILOSOPHY.md   "${pkgdir}/usr/share/doc/${pkgname}/PHILOSOPHY.md"
    # GORILLA OVERRIDE (2026-08-20): the project-wide dual-track document, which
    # both binary packages ship and this recipe did not. Found by diffing the
    # simulated package() output against the built .pkg.tar.zst rather than by
    # reading the two files.
    install -Dm644 Changelogs/DOCUMENTATION.dual-track.md \
        "${pkgdir}/usr/share/doc/${pkgname}/DOCUMENTATION.dual-track.md"

    # GORILLA OVERRIDE (2026-08-20): the full documentation set, matching
    # scripts/build-arch.sh and the .deb. This shipped four documents where the
    # binary packages ship sixty-odd, so someone who built from source got the
    # program without the commands reference, the measured footprint, the
    # satellite guide, the security audit or any of the OSINT research
    # documentation. The whole "why and how" is the deliverable here, not a
    # bonus attached to one install route.
    for d in CONTROL-AND-COST SETTINGS COMMANDS FOOTPRINT SATELLITE SHELL-SAFETY \
             SECURITY-AUDIT-2026-08-18 CODE-REVIEW SESSIONS-AND-STORAGE \
             OSINT-RESEARCH OSINT-DOCTRINE OSINT-SOURCE-CATALOG FIND-TOOL-METRICS; do
        [ -f "docs/$d.md" ] && install -Dm644 "docs/$d.md" \
            "${pkgdir}/usr/share/doc/${pkgname}/$d.md"
    done

    for cl in Changelogs/CHANGELOG*.md; do
        [ -f "$cl" ] && install -Dm644 "$cl" \
            "${pkgdir}/usr/share/doc/${pkgname}/$(basename "$cl")"
    done
    # GORILLA OVERRIDE (2026-08-20): *release-notes*.md, not *release-notes.md.
    # THIRD copy of one bug - build-deb.sh and build-arch.sh carried it too. The
    # dual-track docs split into v<ver>-release-notes.layman.md and
    # .developer.md, and the anchored glob matches NEITHER, so every package
    # built after the split shipped sixty older releases' notes and none for the
    # release it actually was. The full-looking directory is what kept it
    # invisible: grepping for "release-notes" returned plenty and read as a pass.
    # Verify by the SPECIFIC version, never by the class of file.
    for rn in Changelogs/*release-notes*.md; do
        [ -f "$rn" ] && install -Dm644 "$rn" \
            "${pkgdir}/usr/share/doc/${pkgname}/$(basename "$rn")"
    done
}
