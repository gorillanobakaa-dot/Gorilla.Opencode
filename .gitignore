# Per-release checksums: generated at release time and uploaded as a release
# asset, which is where users verify against. Keeping copies in the repo just
# accumulates stale duplicates of what GitHub already serves.
SHA256SUMS-*.txt

# Documentation intermediate build artifacts
release_docs_*/*.json
*.prep.json
*.filled.json
checksums.sha256

# Internal Automation & Build Scripts - NEVER UPLOAD TO GITHUB
/scripts/
/Documentation.Scripts/
*.py
*.sh

# Third-party leaked prompts kept LOCAL for study, not redistributed
system-prompts/reference/
